# ============================================================
# Configuração para geração de dados sintéticos
# Cenário base: turma média de ENSINO MÉDIO da REDE PÚBLICA
# ESTADUAL DO PIAUÍ (objeto definido na Etapa 0 - auditoria em
# data/auditoria_fontes.md). Contrastes: .env.nacional,
# .env.publica (alta vulnerabilidade) e .env.elite (privada).
# Cada parâmetro é rastreável a uma fonte oficial/acadêmica
# (ver data/parametros_fontes.md gerado junto com o CSV)
# ============================================================

# --- Geral ---
N_SAMPLES=3000
SEED=42

# --- Rotulagem (LDB, Lei nº 9.394/1996, art. 24) ---
# Aprovação: média final >= 6,0 E frequência >= 75%
LDB_MEDIA_MINIMA=6.0
LDB_FREQ_MINIMA=75
# Banda pedagógica fixa "Em Risco" (decisão de modelagem):
# média projetada em [5,0; 6,5) ou frequência projetada em [75; 80)
BANDA_RISCO_MEDIA_INF=5.0
BANDA_RISCO_MEDIA_SUP=6.5
BANDA_RISCO_FREQ_SUP=80
# Ruído idiossincrático da deriva do 2º semestre (sigma = NOISE_LEVEL/10
# pontos de média; NOISE_LEVEL*0,8 p.p. de frequência) - revarredura em B6
NOISE_LEVEL=3.0

# --- Renda familiar PER CAPITA (deve somar 100) ---
# PROXY (ver auditoria_fontes.md, nota 1): SIS/IBGE - 45,3% da
# população geral do PI em pobreza (2023; linha ~0,5 SM); a pobreza
# infanto-juvenil é sistematicamente maior que a geral (Fundação
# Abrinq/PNAD: 45,6% dos <18 no BR; ~2/3 no NE em 2022) - mantido 60
PORCENT_RENDA_PC_ATE_MEIO_SM=60
PORCENT_RENDA_PC_MEIO_A_1SM=25
PORCENT_RENDA_PC_ACIMA_1SM=15

# --- Demográficos ---
# Fonte: IBGE - Censo Demográfico 2022 (PI): pardos 64,8%, pretos
# 12,3%, brancos 22,6%, amarelos+indígenas ~0,3%; razão de sexo
# 95,81 homens/100 mulheres (~49% masculino)
PORCENT_MASCULINO=49
PORCENT_PARDO=65
PORCENT_PRETO=12
PORCENT_BRANCO=22
PORCENT_AMARELO_INDIGENA=1
# Faixa etária 14-24: predominância de solteiros
PORCENT_SOLTEIRO=93
PORCENT_CASADO_UNIAO=5
PORCENT_ESTADO_CIVIL_OUTRO=2

# --- Série (funil de matrículas do EM, deve somar 100) ---
PORCENT_SERIE_1=38
PORCENT_SERIE_2=33
PORCENT_SERIE_3=29

# --- Distorção idade-série (2+ anos de atraso) ---
# Fonte: INEP - Censo Escolar 2025 / Taxas de Distorção Idade-série
# (rede estadual PI: 21,7%; histórico 2022: 33,2%)
PORCENT_DISTORCAO_IDADE_SERIE=21.7

# --- Socioeconômicos ---
# Fonte: INEP - Sinopse do Censo Escolar (PI: 715.748 estudantes na
# rede pública; % EM público >= média nacional de 82%)
PORCENT_ESCOLA_PUBLICA=85
# PROXY (ver auditoria_fontes.md, nota 2): decisão de modelagem -
# SciELO/CEBAPE 26,3% (EM baixa renda); PI 5-17: 6,8-8,6% (trabalho
# infantil, MTE/PNADc); BR 16-17: 15,3% (2024)
PORCENT_TRABALHA=26.3
# Fonte: IBGE - PNAD Contínua TIC, SIDRA t.7307 (PI 2025: 92,5% dos
# domicílios com internet; 2023: 88,9%)
PORCENT_ACESSO_INTERNET=92.5
# Fonte: IBGE - PNAD Contínua TIC, SIDRA t.7302 (PI 2025: 25,5% dos
# domicílios com microcomputador ou tablet)
PORCENT_POSSUI_COMPUTADOR=25.5

# --- Pé-de-Meia (Lei nº 14.818) ---
# Elegibilidade é REGRA no código (14-24 anos + renda <= 0,5 SM);
# aqui só a taxa de adesão dos elegíveis e a frequência mínima exigida
TAXA_ADESAO_PE_DE_MEIA=85
PE_DE_MEIA_FREQ_MINIMA=80

# --- Outliers de resiliência acadêmica ---
# Perfis vulneráveis de alto desempenho (ex.: Cocal dos Alves-PI)
PORCENT_OUTLIERS_RESILIENCIA=3

# --- Acadêmicos ---
NOTA_MEDIA_BASE=6.2
NOTA_DESVIO=1.3
